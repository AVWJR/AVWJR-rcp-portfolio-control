// Roche Capital Partners — Phase A–F (PostgreSQL / Neon production schema)
// Generated from prisma/schema.prisma by scripts/prisma-prepare.mjs — edit models there.
// DATABASE_URL = Neon pooled (-pooler). DIRECT_URL = Neon unpooled (prisma db push).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EntityType {
  HOLDCO
  OPCO
  SPE
}

enum SpeStrategy {
  VALUE_ADD_GARDEN
  STABILIZED
  LIGHT_REHAB
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum CashFlowClass {
  OPERATING
  INVESTING
  FINANCING
  NONE
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

enum ChecklistItemStatus {
  PENDING
  DONE
  NA
}

enum PeriodCloseAction {
  SOFT_CLOSE
  HARD_LOCK
  REOPEN
}

enum CapexClassification {
  CAPEX
  REPAIRS_MAINTENANCE
}

enum CapexProjectStatus {
  OPEN
  CIP
  PLACED_IN_SERVICE
  CLOSED
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum UnitStatus {
  OCCUPIED
  VACANT
  DOWN
}

model Entity {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  type         EntityType
  parentId     String?
  parent       Entity?      @relation("EntityTree", fields: [parentId], references: [id])
  children     Entity[]     @relation("EntityTree")
  ownershipBps Int          @default(10000) // 10000 = 100.00% wholly owned
  unitCount    Int?
  strategy     SpeStrategy?
  currency     String       @default("USD")
  locale       String       @default("en-US")
  timezone     String       @default("America/New_York")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  accounts         Account[]
  periods          Period[]
  journals         Journal[]
  units            Unit[]
  budgetLines      BudgetLine[]
  loans            Loan[]
  capexProjects    CapexProject[]
  taxAdjustments   TaxAdjustment[]
  partners         Partner[]
  vendorPayments   VendorPayment[]
  vaultDocuments   VaultDocument[]
  reportJobs       ReportJob[]
}

/// Master template rows use entityId = null. Entity CoA is cloned from the template.
model Account {
  id            String         @id @default(cuid())
  entityId      String?
  entity        Entity?        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          AccountType
  normalBalance NormalBalance
  isContra      Boolean        @default(false)
  isTemplate    Boolean        @default(false)
  isBelowNoi    Boolean        @default(false)
  isCash        Boolean        @default(false)
  reportGroup   String
  sortOrder     Int
  cashFlowClass CashFlowClass  @default(NONE)
  createdAt     DateTime       @default(now())

  lines JournalLine[]

  @@unique([entityId, code])
  @@index([entityId, reportGroup])
}

model Period {
  id        String       @id @default(cuid())
  entityId  String
  entity    Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  label     String
  startDate DateTime
  endDate   DateTime
  status         PeriodStatus @default(OPEN)
  softClosedAt   DateTime?
  lockedAt       DateTime?
  reopenedAt     DateTime?
  reopenReason   String?
  reopenTicket   String?
  createdAt      DateTime     @default(now())

  journals  Journal[]
  checklist CloseChecklistItem[]
  closeEvents PeriodCloseEvent[]

  @@unique([entityId, year, month])
}

model Journal {
  id          String        @id @default(cuid())
  entityId    String
  entity      Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  periodId    String
  period      Period        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  date        DateTime
  memo        String
  source      String        @default("manual")
  status      JournalStatus @default(DRAFT)
  postedAt    DateTime?
  createdAt   DateTime      @default(now())

  lines JournalLine[]

  @@index([entityId, periodId, status])
}

model JournalLine {
  id        String  @id @default(cuid())
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     BigInt  @default(0)
  credit    BigInt  @default(0)
  memo      String?

  @@index([accountId])
}

/// Unit master / rent-roll snapshot. Occupancy KPIs are computed from these rows,
/// never from the GL. DOWN units are offline (rehab) and excluded from rentable.
model Unit {
  id              String     @id @default(cuid())
  entityId        String
  entity          Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  unitCode        String
  floorplan       String
  beds            Int
  bathsTenths     Int // 10 = 1.0 bath, 15 = 1.5
  sqft            Int
  status          UnitStatus
  marketRent      BigInt
  inPlaceRent     BigInt     @default(0)
  leaseStart      DateTime?
  leaseEnd        DateTime?
  concessionCents BigInt     @default(0)
  asOfDate        DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([entityId, unitCode])
  @@index([entityId, status])
}

/// Monthly operating budget by CoA account, integer cents, natural magnitude
/// (GPR / other income / expenses / vacancy / concessions are stored positive).
model BudgetLine {
  id          String   @id @default(cuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  accountCode String
  amount      BigInt
  source      String   @default("seed")
  createdAt   DateTime @default(now())

  @@unique([entityId, year, month, accountCode])
  @@index([entityId, year, month])
}

/// First-mortgage loan file. UPB and payment amounts are integer cents.
/// Rate is annual basis points (568 = 5.68%). Covenant thresholds are also bps
/// (DSCR 12500 = 1.25x; debt yield 800 = 8.00%). Do not invent LTV from book cost.
model Loan {
  id                      String   @id @default(cuid())
  entityId                String
  entity                  Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                    String
  lenderName              String
  originalPrincipalCents  BigInt
  currentUpbCents         BigInt
  interestRateBps         Int
  paymentCents            BigInt
  originationDate         DateTime
  maturityDate            DateTime
  reserveRequirementCents BigInt   @default(0)
  reserveAccountCode      String   @default("1020")
  dscrThresholdBps        Int      @default(12500)
  debtYieldThresholdBps   Int      @default(800)
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  payments LoanPayment[]

  @@index([entityId])
}

/// Scheduled or posted debt-service row. August seed rows match GL 6110 / principal.
model LoanPayment {
  id                 String    @id @default(cuid())
  loanId             String
  loan               Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  dueDate            DateTime
  interestCents      BigInt
  principalCents     BigInt
  reserveCents       BigInt    @default(0)
  endingUpbCents     BigInt
  currentPortionCents BigInt
  longTermPortionCents BigInt
  posted             Boolean   @default(false)
  journalId          String?
  source             String    @default("schedule")
  createdAt          DateTime  @default(now())

  @@unique([loanId, year, month])
  @@index([loanId])
}

/// CapEx project or R&M tracker. CapEx spends hit CIP (1460) until placed in service.
/// R&M is operating (5210) and stays in NOI — never capitalize it.
model CapexProject {
  id                     String              @id @default(cuid())
  entityId               String
  entity                 Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                   String
  classification         CapexClassification
  status                 CapexProjectStatus  @default(OPEN)
  budgetCents            BigInt
  spentCents             BigInt              @default(0)
  cipCents               BigInt              @default(0)
  placedInServiceCents   BigInt              @default(0)
  placedInServiceAt      DateTime?
  fixedAssetAccountCode  String              @default("1430")
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  costs CapexCost[]

  @@index([entityId])
}

model CapexCost {
  id          String       @id @default(cuid())
  projectId   String
  project     CapexProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  amountCents BigInt
  kind        String
  accountCode String
  memo        String?
  journalId   String?
  createdAt   DateTime     @default(now())

  @@index([projectId])
}

model CloseChecklistItem {
  id         String               @id @default(cuid())
  periodId   String
  period     Period               @relation(fields: [periodId], references: [id], onDelete: Cascade)
  code       String
  label      String
  sortOrder  Int
  status     ChecklistItemStatus  @default(PENDING)
  notes      String?
  reviewedAt DateTime?

  @@unique([periodId, code])
}

model PeriodCloseEvent {
  id        String            @id @default(cuid())
  periodId  String
  period    Period            @relation(fields: [periodId], references: [id], onDelete: Cascade)
  action    PeriodCloseAction
  reason    String?
  ticket    String?
  createdAt DateTime          @default(now())

  @@index([periodId])
}

/// CPA books-to-tax overlay. Live book columns come from the GL; these rows
/// are seeded sample adjustments (and optional CPA notes). Not a filed return.
model TaxAdjustment {
  id              String   @id @default(cuid())
  entityId        String
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  lineCode        String
  label           String
  basis           String
  booksCents      BigInt   @default(0)
  taxCents        BigInt   @default(0)
  notes           String?
  source          String   @default("seed")
  createdAt       DateTime @default(now())

  @@unique([entityId, year, month, lineCode])
  @@index([entityId, year, month])
}

/// MACRS recovery-period reference table (hooks, not a depreciation engine).
model MacrsLifeHook {
  id            String  @id @default(cuid())
  assetClass    String  @unique
  label         String
  accountCode   String?
  recoveryYears Float?
  convention    String
  depreciable   Boolean
  notes         String
}

model Partner {
  id           String   @id @default(cuid())
  entityId     String
  entity       Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  code         String
  name         String
  role         String
  ownershipBps Int
  tinLast4     String?
  notes        String?
  createdAt    DateTime @default(now())

  activities PartnerCapitalActivity[]

  @@unique([entityId, code])
  @@index([entityId])
}

model PartnerCapitalActivity {
  id                 String   @id @default(cuid())
  partnerId          String
  partner            Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  beginningCents     BigInt
  contributionsCents BigInt   @default(0)
  distributionsCents BigInt   @default(0)
  bookNiAllocCents   BigInt   @default(0)
  endingCents        BigInt
  notes              String?

  @@unique([partnerId, year, month])
}

model Vendor {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  form1099    String   @default("NONE")
  tinLast4    String?
  addressLine String?
  city        String?
  state       String?
  zip         String?
  notes       String?
  createdAt   DateTime @default(now())

  payments VendorPayment[]
}

/// Reportable-payment overlay. Phase A AP has no vendor invoice subledger.
model VendorPayment {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  amountCents BigInt
  accountCode String
  memo        String?
  reportable  Boolean  @default(true)
  source      String   @default("seed")
  createdAt   DateTime @default(now())

  @@index([entityId, year, month])
  @@index([vendorId])
}

model VaultDocument {
  id          String   @id @default(cuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  filename    String
  mimeType    String
  storagePath String
  byteSize    Int
  notes       String?
  uploadedAt  DateTime @default(now())

  @@index([entityId, kind])
}

model ReportJob {
  id            String    @id @default(cuid())
  code          String    @unique
  packId        String
  title         String
  cadence       String
  entityCode    String
  periodLabel   String
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  lastStatus    String    @default("IDLE")
  lastOutputDir String?
  lastError     String?
  notes         String?
  createdAt     DateTime  @default(now())
  entityId      String?
  entity        Entity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)

  runs ReportJobRun[]
}

model ReportJobRun {
  id          String    @id @default(cuid())
  jobId       String
  job         ReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String
  outputDir   String?
  filesJson   String?
  error       String?
  packId      String
  entityCode  String
  periodLabel String

  @@index([jobId, startedAt])
}
