// Roche Capital Partners — Phase A–F ledger, operating, debt, dashboards, tax, vault
// Local demo (this file): SQLite via DATABASE_URL="file:./dev.db"
// Production: scripts/prisma-prepare.mjs writes schema.prod.prisma (postgresql + DIRECT_URL)
// when DATABASE_URL is postgres:// or when Vercel builds. Do not switch this file by hand.
// Amounts are integer USD cents (BigInt) to keep trial-balance math exact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EntityType {
  HOLDCO
  OPCO
  SPE
}

enum SpeStrategy {
  VALUE_ADD_GARDEN
  STABILIZED
  LIGHT_REHAB
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum CashFlowClass {
  OPERATING
  INVESTING
  FINANCING
  NONE
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

enum ChecklistItemStatus {
  PENDING
  DONE
  NA
}

enum PeriodCloseAction {
  SOFT_CLOSE
  HARD_LOCK
  REOPEN
}

enum CapexClassification {
  CAPEX
  REPAIRS_MAINTENANCE
}

enum CapexProjectStatus {
  OPEN
  CIP
  PLACED_IN_SERVICE
  CLOSED
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum DealIntakeStatus {
  DRAFT
  AWAITING_FILES
  READY
  APPLIED
  FAILED
}

/// Soft-archive only. LIVE SPEs appear on Deals and in OpCo rollup. ARCHIVED SPEs
/// keep books and vault for study on /archive — never a hard wipe.
enum EntityLifecycle {
  LIVE
  ARCHIVED
}

/// Library lifecycle. Separate from EntityLifecycle. Only OWNED SPEs feed the
/// real OpCo books. prisma db push adds this column with @default(OWNED), so
/// existing production rows become OWNED without a data migration. Read-time
/// effectiveDealStatus() still treats lifecycleStatus ARCHIVED as Archived
/// (the column stays OWNED on those rows) and treats a missing value as OWNED.
enum DealStatus {
  PIPELINE
  SCREENED
  OWNED
  ARCHIVED
  TEST
}

enum UnitStatus {
  OCCUPIED
  VACANT
  DOWN
}

model Entity {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  type         EntityType
  parentId     String?
  parent       Entity?      @relation("EntityTree", fields: [parentId], references: [id])
  children     Entity[]     @relation("EntityTree")
  ownershipBps Int          @default(10000) // 10000 = 100.00% wholly owned
  unitCount    Int?
  strategy     SpeStrategy?
  currency     String       @default("USD")
  locale       String       @default("en-US")
  timezone         String          @default("America/New_York")
  lifecycleStatus  EntityLifecycle @default(LIVE)
  archivedAt       DateTime?
  archivedBy       String?
  restoredAt       DateTime?
  restoredBy       String?
  /// See DealStatus. Default OWNED fills existing rows on db push.
  dealStatus            DealStatus @default(OWNED)
  streetAddress         String?
  city                  String?
  state                 String?
  metro                 String?
  msa                   String?
  submarket             String?
  propertyType          String?
  vintageYear           Int?
  assetClass            String?
  unitCountOverride     Int?
  purchasePriceCents    BigInt?
  appraisedValueCents   BigInt?
  businessPlan          String?
  renovationBudgetCents BigInt?
  holdPeriodYears       Int?
  /// Blank until the owner types it. Never default a percent or a dollar amount.
  amFeeBps              Int?
  otherLpFeeCents       BigInt?
  otherLpFeeNote        String?
  /// OpCo G&A budget only. Blank until set. Not a deal-level assumption.
  gaBudgetCents         BigInt?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  accounts         Account[]
  periods          Period[]
  journals         Journal[]
  units            Unit[]
  budgetLines      BudgetLine[]
  loans            Loan[]
  capexProjects    CapexProject[]
  taxAdjustments   TaxAdjustment[]
  partners         Partner[]
  vendorPayments   VendorPayment[]
  vaultDocuments   VaultDocument[]
  reportJobs       ReportJob[]
  dealIntakes      DealIntake[]
  waterfall        SpeWaterfall?
  vendorAccountMaps VendorAccountMap[]
  monthEndUploads  MonthEndUpload[]
  leaseSnapshots   LeasePeriodSnapshot[]
  monthEndEvents   MonthEndEvent[]
  tieOutTolerances TieOutTolerance[]
  distributionEvents DistributionEvent[]
  distributionAudits DistributionAudit[]
  analysisSnapshots  DealAnalysisSnapshot[]
  statusEvents       DealStatusEvent[]
  modelMemberships   PortfolioModelDeal[]
  assetPlan          AssetPlan?

  @@index([dealStatus])
}

/// Per-SPE LP/GP distribution waterfall. Missing row = 100% look-through
/// (legacy OpCo stack). Saving a template is an explicit Principal choice.
model SpeWaterfall {
  id                     String   @id @default(cuid())
  entityId               String   @unique
  entity                 Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  templateId             String   @default("look_through_100")
  prefRateBps            Int      @default(800)
  compounding            String   @default("NONE")
  catchUpEnabled         Boolean  @default(false)
  catchUpBps             Int      @default(10000)
  gpCoInvestBps          Int      @default(0)
  coGpName               String?
  coGpOfPromoteBps       Int      @default(0)
  coGpCoInvestShareBps   Int      @default(0)
  promoteBase            String   @default("DISTRIBUTABLE_CASH")
  lookbackClawback       Boolean  @default(false)
  lpContributedCents     BigInt   @default(0)
  /// Required. Blank vs a typed 0 is stored in tiersJson.capital (null vs "0"). Preview builds must not alter this column.
  unreturnedCapitalCents BigInt   @default(0)
  /// Required. Blank vs a typed 0 is stored in tiersJson.capital (null vs "0").
  unpaidPrefCents        BigInt   @default(0)
  prefPaidToDateCents    BigInt   @default(0)
  notes                  String?
  tiersJson              String   @default("[]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([templateId])
}

/// Master template rows use entityId = null. Entity CoA is cloned from the template.
model Account {
  id            String         @id @default(cuid())
  entityId      String?
  entity        Entity?        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          AccountType
  normalBalance NormalBalance
  isContra      Boolean        @default(false)
  isTemplate    Boolean        @default(false)
  isBelowNoi    Boolean        @default(false)
  isCash        Boolean        @default(false)
  reportGroup   String
  sortOrder     Int
  cashFlowClass CashFlowClass  @default(NONE)
  createdAt     DateTime       @default(now())

  lines JournalLine[]

  @@unique([entityId, code])
  @@index([entityId, reportGroup])
}

model Period {
  id        String       @id @default(cuid())
  entityId  String
  entity    Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  label     String
  startDate DateTime
  endDate   DateTime
  status         PeriodStatus @default(OPEN)
  softClosedAt   DateTime?
  lockedAt       DateTime?
  reopenedAt     DateTime?
  reopenReason   String?
  reopenTicket   String?
  basis          String       @default("ACCRUAL")
  /// Explicit income-file choice for this SPE and period. Null keeps the newest income statement.
  incomeSourceUploadId  String?
  /// Explicit balance-sheet choice for this SPE and period. Null keeps the newest balance sheet.
  balanceSourceUploadId String?
  createdAt      DateTime     @default(now())

  journals  Journal[]
  checklist CloseChecklistItem[]
  closeEvents PeriodCloseEvent[]

  @@unique([entityId, year, month])
}

model Journal {
  id          String        @id @default(cuid())
  entityId    String
  entity      Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  periodId    String
  period      Period        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  date        DateTime
  memo        String
  source      String        @default("manual")
  status      JournalStatus @default(DRAFT)
  postedAt          DateTime?
  reversesJournalId String?
  reversesJournal   Journal?  @relation("JournalReversal", fields: [reversesJournalId], references: [id], onDelete: SetNull)
  reversedBy        Journal[] @relation("JournalReversal")
  createdAt         DateTime  @default(now())

  lines JournalLine[]

  @@index([entityId, periodId, status])
  @@index([reversesJournalId])
}

model JournalLine {
  id        String  @id @default(cuid())
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     BigInt  @default(0)
  credit    BigInt  @default(0)
  memo      String?

  @@index([accountId])
}

/// Unit master / rent-roll snapshot. Occupancy KPIs are computed from these rows,
/// never from the GL. DOWN units are offline (rehab) and excluded from rentable.
model Unit {
  id              String     @id @default(cuid())
  entityId        String
  entity          Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  unitCode        String
  floorplan       String
  beds            Int
  bathsTenths     Int // 10 = 1.0 bath, 15 = 1.5
  sqft            Int
  status          UnitStatus
  /// MODEL, EMPLOYEE, ADMIN, or DOWN. Null on ordinary occupied and vacant units.
  substatus       String?
  marketRent      BigInt
  inPlaceRent     BigInt     @default(0)
  leaseStart      DateTime?
  leaseEnd        DateTime?
  concessionCents BigInt     @default(0)
  asOfDate        DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([entityId, unitCode])
  @@index([entityId, status])
}

/// Monthly operating budget by CoA account, integer cents, natural magnitude
/// (GPR / other income / expenses / vacancy / concessions are stored positive).
model BudgetLine {
  id          String   @id @default(cuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  accountCode String
  amount      BigInt
  source      String   @default("seed")
  createdAt   DateTime @default(now())

  @@unique([entityId, year, month, accountCode])
  @@index([entityId, year, month])
}

/// First-mortgage loan file. UPB and payment amounts are integer cents.
/// Rate is annual basis points (568 = 5.68%). Covenant thresholds are also bps
/// (DSCR 12500 = 1.25x; debt yield 800 = 8.00%). Do not invent LTV from book cost.
model Loan {
  id                      String   @id @default(cuid())
  entityId                String
  entity                  Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                    String
  lenderName              String
  originalPrincipalCents  BigInt
  currentUpbCents         BigInt
  interestRateBps         Int
  paymentCents            BigInt
  originationDate         DateTime
  maturityDate            DateTime
  reserveRequirementCents BigInt   @default(0)
  reserveAccountCode      String   @default("1020")
  dscrThresholdBps        Int      @default(12500)
  debtYieldThresholdBps   Int      @default(800)
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  payments LoanPayment[]

  @@index([entityId])
}

/// Scheduled or posted debt-service row. August seed rows match GL 6110 / principal.
model LoanPayment {
  id                 String    @id @default(cuid())
  loanId             String
  loan               Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  dueDate            DateTime
  interestCents      BigInt
  principalCents     BigInt
  reserveCents       BigInt    @default(0)
  endingUpbCents     BigInt
  currentPortionCents BigInt
  longTermPortionCents BigInt
  posted             Boolean   @default(false)
  journalId          String?
  source             String    @default("schedule")
  createdAt          DateTime  @default(now())

  @@unique([loanId, year, month])
  @@index([loanId])
}

/// CapEx project or R&M tracker. CapEx spends hit CIP (1460) until placed in service.
/// R&M is operating (5210) and stays in NOI — never capitalize it.
model CapexProject {
  id                     String              @id @default(cuid())
  entityId               String
  entity                 Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                   String
  classification         CapexClassification
  status                 CapexProjectStatus  @default(OPEN)
  budgetCents            BigInt
  spentCents             BigInt              @default(0)
  cipCents               BigInt              @default(0)
  placedInServiceCents   BigInt              @default(0)
  placedInServiceAt      DateTime?
  fixedAssetAccountCode  String              @default("1430")
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  costs CapexCost[]

  @@index([entityId])
}

model CapexCost {
  id          String       @id @default(cuid())
  projectId   String
  project     CapexProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  amountCents BigInt
  kind        String
  accountCode String
  memo        String?
  journalId   String?
  createdAt   DateTime     @default(now())

  @@index([projectId])
}

model CloseChecklistItem {
  id         String               @id @default(cuid())
  periodId   String
  period     Period               @relation(fields: [periodId], references: [id], onDelete: Cascade)
  code       String
  label      String
  sortOrder  Int
  status     ChecklistItemStatus  @default(PENDING)
  notes      String?
  reviewedAt DateTime?

  @@unique([periodId, code])
}

model PeriodCloseEvent {
  id        String            @id @default(cuid())
  periodId  String
  period    Period            @relation(fields: [periodId], references: [id], onDelete: Cascade)
  action    PeriodCloseAction
  reason    String?
  ticket    String?
  createdAt DateTime          @default(now())

  @@index([periodId])
}

/// CPA books-to-tax overlay. Live book columns come from the GL; these rows
/// are seeded sample adjustments (and optional CPA notes). Not a filed return.
model TaxAdjustment {
  id              String   @id @default(cuid())
  entityId        String
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  lineCode        String
  label           String
  basis           String
  booksCents      BigInt   @default(0)
  taxCents        BigInt   @default(0)
  notes           String?
  source          String   @default("seed")
  createdAt       DateTime @default(now())

  @@unique([entityId, year, month, lineCode])
  @@index([entityId, year, month])
}

/// MACRS recovery-period reference table (hooks, not a depreciation engine).
model MacrsLifeHook {
  id            String  @id @default(cuid())
  assetClass    String  @unique
  label         String
  accountCode   String?
  recoveryYears Float?
  convention    String
  depreciable   Boolean
  notes         String
}

model Partner {
  id           String   @id @default(cuid())
  entityId     String
  entity       Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  code         String
  name         String
  role         String
  ownershipBps Int
  tinLast4     String?
  notes        String?
  createdAt    DateTime @default(now())

  activities PartnerCapitalActivity[]

  @@unique([entityId, code])
  @@index([entityId])
}

model PartnerCapitalActivity {
  id                 String   @id @default(cuid())
  partnerId          String
  partner            Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  beginningCents     BigInt
  contributionsCents BigInt   @default(0)
  distributionsCents BigInt   @default(0)
  bookNiAllocCents   BigInt   @default(0)
  endingCents        BigInt
  notes              String?

  @@unique([partnerId, year, month])
}

model Vendor {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  form1099    String   @default("NONE")
  tinLast4    String?
  addressLine String?
  city        String?
  state       String?
  zip         String?
  notes       String?
  createdAt   DateTime @default(now())

  payments VendorPayment[]
}

/// Reportable-payment overlay. Phase A AP has no vendor invoice subledger.
model VendorPayment {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  amountCents BigInt
  accountCode String
  memo        String?
  reportable  Boolean  @default(true)
  source      String   @default("seed")
  createdAt   DateTime @default(now())

  @@index([entityId, year, month])
  @@index([vendorId])
}

model VaultDocument {
  id          String   @id @default(cuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  filename    String
  mimeType    String
  storagePath String
  byteSize    Int
  notes       String?
  uploadedAt  DateTime @default(now())

  @@index([entityId, kind])
}

/// Durable file bytes when the local filesystem is ephemeral (Vercel) and
/// Vercel Blob is not configured. storagePath on vault/intake rows is `db:{id}`.
model StoredBlob {
  id        String   @id @default(cuid())
  key       String
  mimeType  String
  byteSize  Int
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([key])
}

/// Guided Add Deal session. Draft JSON-equivalent fields persist so refresh
/// does not lose Principal progress. Files land in the vault after the SPE exists.
model DealIntake {
  id                    String           @id @default(cuid())
  status                DealIntakeStatus @default(DRAFT)
  currentStep           Int              @default(1)
  goal                  String?
  targetPeriod          String?
  speName               String?
  speCode               String?
  unitCount             Int?
  strategy              SpeStrategy?
  parentOpCoCode        String           @default("RCP-OPCO")
  entityId              String?
  entity                Entity?          @relation(fields: [entityId], references: [id], onDelete: SetNull)
  sourcesJson           String           @default("[\"upload\"]")
  loanName              String?
  loanLender            String?
  loanUpbCents          BigInt?
  loanRateBps           Int?
  loanPaymentCents      BigInt?
  loanOrigination       DateTime?
  loanMaturity          DateTime?
  dscrThresholdBps      Int?
  debtYieldThresholdBps Int?
  /// Null means Owned at create (today's Add Deal behavior).
  requestedDealStatus   DealStatus?
  lastError             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  files DealIntakeFile[]

  @@index([status])
  @@index([entityId])
}

model DealIntakeFile {
  id              String     @id @default(cuid())
  intakeId        String
  intake          DealIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  source          String
  classification  String     @default("other")
  filename        String
  mimeType        String
  byteSize        Int
  storagePath     String
  vaultDocumentId String?
  remoteId        String?
  status          String     @default("stored")
  lastError       String?
  createdAt       DateTime   @default(now())

  @@index([intakeId])
}

model ReportJob {
  id            String    @id @default(cuid())
  code          String    @unique
  packId        String
  title         String
  cadence       String
  entityCode    String
  periodLabel   String
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  lastStatus    String    @default("IDLE")
  lastOutputDir String?
  lastError     String?
  notes         String?
  createdAt     DateTime  @default(now())
  entityId      String?
  entity        Entity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)

  runs ReportJobRun[]
}

model ReportJobRun {
  id          String    @id @default(cuid())
  jobId       String
  job         ReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String
  outputDir   String?
  filesJson   String?
  error       String?
  packId      String
  entityCode  String
  periodLabel String

  @@index([jobId, startedAt])
}

/// Remembered vendor-line → RCP account map for one SPE. Additive. Never deletes history.
model VendorAccountMap {
  id              String   @id @default(cuid())
  entityId        String
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sourceSystem    String   @default("")
  sourceAccountNo String   @default("")
  normalizedLabel String
  accountCode     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityId, sourceSystem, sourceAccountNo, normalizedLabel])
  @@index([entityId])
}

/// Original month-end file. Rows are insert-only — closed months are not overwritten by deleting these.
model MonthEndUpload {
  id             String   @id @default(cuid())
  entityId       String
  entity         Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  filename       String
  mimeType       String   @default("application/octet-stream")
  classification String
  byteSize       Int
  sha256         String
  storagePath    String
  parsedJson     String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([entityId, year, month])
}

/// Period snapshot of the tenant/lease master. The live Unit table stays the current rent roll.
model LeasePeriodSnapshot {
  id          String   @id @default(cuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  unitCode    String
  payloadJson String
  createdAt   DateTime @default(now())

  @@unique([entityId, year, month, unitCode])
  @@index([entityId, year, month])
}

/// Per-SPE tie-out tolerance. No row means no threshold. Do not seed defaults.
model TieOutTolerance {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  key       String
  cents     BigInt?
  bps       Int?
  days      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, key])
  @@index([entityId])
}

model MonthEndEvent {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  action    String
  detail    String
  createdAt DateTime @default(now())

  @@index([entityId, year, month])
}

/// Posted distribution. Rows are insert-only. A correction is a new row
/// whose reversesEventId points at the original. Amounts are USD cents.
model DistributionEvent {
  id                    String   @id @default(cuid())
  entityId              String
  entity                Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  eventDate             DateTime
  year                  Int
  month                 Int
  periodLabel           String
  grossCents            BigInt
  /// OPERATING_CASH or CAPITAL_EVENT
  source                String
  memo                  String?
  waterfallSnapshotJson String
  actor                 String?
  /// Monotonic per deal. The unique pair is the lock for concurrent posts.
  sequence              Int
  /// Set only on a reversing row. Unique so an event is reversed at most once.
  reversesEventId       String?  @unique
  reversesEvent         DistributionEvent?  @relation("DistributionReversal", fields: [reversesEventId], references: [id], onDelete: SetNull)
  reversedBy            DistributionEvent?  @relation("DistributionReversal")
  monthsAccrued         Int      @default(0)
  capitalContributedCents BigInt
  capitalReturnedCents    BigInt
  unreturnedCapitalCents  BigInt
  prefAccruedCents        BigInt
  prefPaidCents           BigInt
  prefUnpaidCents         BigInt
  catchUpPaidCents        BigInt
  catchUpTargetCents      BigInt
  promoteEarnedCents      BigInt
  cumulativeLpCents       BigInt
  cumulativeRcpCents      BigInt
  cumulativeCoGpCents     BigInt
  tierTotalsJson          String   @default("{}")
  createdAt               DateTime @default(now())

  lines  DistributionAllocation[]
  audits DistributionAudit[]

  @@unique([entityId, sequence])
  @@index([entityId, createdAt])
}

model DistributionAllocation {
  id        String             @id @default(cuid())
  eventId   String
  event     DistributionEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tierKind  String
  tierLabel String
  lpCents   BigInt
  rcpCents  BigInt
  coGpCents BigInt
  sortOrder Int

  @@index([eventId])
}

/// Append-only log of each post and reversal. Not an edit of the event.
model DistributionAudit {
  id        String              @id @default(cuid())
  entityId  String
  entity    Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  eventId   String?
  event     DistributionEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  action    String
  actor     String?
  detail    String
  createdAt DateTime            @default(now())

  @@index([entityId, createdAt])
}

/// Dated underwriting ratios for one deal. New rows only — old snapshots stay.
/// LP net IRR, LP cash yield, and RCP IRR stay null until fees and cash flows are on file.
model DealAnalysisSnapshot {
  id                  String   @id @default(cuid())
  entityId            String
  entity              Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  asOfDate            DateTime
  periodLabel         String
  recordedAt          DateTime @default(now())
  recordedBy          String   @default("principal")
  basisLabel          String
  noiBasisLabel       String
  sourceFiles         String   @default("[]")
  dscrBps             Int?
  debtYieldBps        Int?
  cashOnCashBps       Int?
  occupancyBps        Int?
  expenseRatioBps     Int?
  noiCents            BigInt?
  annualizedNoiCents  BigInt?
  capRateBps          Int?
  ltvBps              Int?
  pricePerUnitCents   BigInt?
  prefRateBps         Int?
  catchUpBps          Int?
  promoteSplitLabel   String?
  coGpOfPromoteBps    Int?
  gpCoInvestBps       Int?
  equityRequiredCents BigInt?
  lpEquityCents       BigInt?
  rcpShareBps         Int?
  unitCount           Int?
  /// Phase 2. Always null. Never a computed stand-in.
  lpNetIrrBps         Int?
  lpAvgCashYieldBps   Int?
  lpYear1CashYieldBps Int?
  rcpIrrBps           Int?

  @@index([entityId, recordedAt])
}

/// Who changed a deal's Library status, when, and why.
model DealStatusEvent {
  id         String   @id @default(cuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  reason     String
  actor      String   @default("principal")
  createdAt  DateTime @default(now())

  @@index([entityId, createdAt])
}

/// Saved sentence-builder sets. Library search now; Models and the optimizer later.
model CriteriaPreset {
  id           String   @id @default(cuid())
  name         String   @unique
  criteriaJson String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Editable Library lists. Seeded states and property types are inserted if missing.
/// Metros are added when a deal saves one. Rows are never removed because of age.
model LibraryPickItem {
  id        String   @id @default(cuid())
  kind      String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([kind, label])
  @@index([kind, sortOrder])
}

/// Named what-if list of deals. Read-only analysis.
/// Never posts journals, never writes the distribution ledger, and never changes deal status.
model PortfolioModel {
  id                   String   @id @default(cuid())
  name                 String
  /// LIVE or TEST. Test deals belong only in TEST models.
  kind                 String   @default("LIVE")
  holdYears            Int      @default(5)
  growthBps            Int      @default(0)
  /// Exit cap rate in basis points. Null means no exit value was typed.
  exitCapRateBps       Int?
  /// Optional OpCo pref. Null rate or null capital means it is not modeled.
  opcoPrefRateBps      Int?
  opcoPrefCapitalCents BigInt?
  opcoLpSplitBps       Int      @default(8000)
  opcoGpSplitBps       Int      @default(2000)
  criteriaJson         String   @default("[]")
  copiedFromId         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deals                PortfolioModelDeal[]

  @@index([kind])
}

/// One deal inside a Model. Deleting the row removes it from the Model only.
model PortfolioModelDeal {
  id                String         @id @default(cuid())
  modelId           String
  model             PortfolioModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  entityId          String
  entity            Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sortOrder         Int            @default(0)
  /// False while Pipeline. True for Screened and Owned. The optimizer is Phase 3.
  optimizerEligible Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@unique([modelId, entityId])
  @@index([entityId])
}

/// One asset-management plan per deal. Header only. History lives on PlanEvent.
model AssetPlan {
  id                 String   @id @default(cuid())
  entityId           String   @unique
  entity             Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  /// OPEN until the first saved score. ANALYZED after that.
  status             String   @default("OPEN")
  lastAnalyzedAt     DateTime?
  /// Visible method id. Phase 1 stores observations and does not blend them.
  blendMethodVersion String   @default("phase1-no-blend-v1")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  observations    MarketObservation[]
  recommendations PlanRecommendation[]
  opportunities   IncomeOpportunity[]
  events          PlanEvent[]
}

/// Insert-only market or PM comp observation. No update and no delete in the app.
model MarketObservation {
  id             String    @id @default(cuid())
  planId         String
  plan           AssetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sourceName     String
  /// PM_COMP, PUBLIC, or ZORI.
  sourceType     String
  geography      String
  floorplan      String?
  beds           Int?
  valueCents     BigInt?
  rangeLowCents  BigInt?
  rangeHighCents BigInt?
  trendNote      String?
  /// Public specials or concessions named by the source. Not a resident concession.
  specialsNote   String?
  vintageDate    DateTime?
  asOfDate       DateTime
  retrievedAt    DateTime
  termsNote      String
  createdAt      DateTime  @default(now())

  @@index([planId, createdAt])
}

/// Current recommendation pointer. Supersede by inserting a PlanEvent. Never deleted here.
model PlanRecommendation {
  id               String    @id @default(cuid())
  planId           String
  plan             AssetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  code             String
  title            String
  reason           String
  impactCents      BigInt?
  revpauDeltaCents BigInt?
  confidence       String
  /// OPEN or SUPERSEDED.
  status           String    @default("OPEN")
  sourceLabel      String
  sourceAsOf       DateTime?
  supersededAt     DateTime?
  createdAt        DateTime  @default(now())

  @@index([planId, status])
}

enum IncomeOpportunityStatus {
  IDEA
  APPROVED
  DECLINED
  LIVE
  MEASURED
}

/// Manual income idea. Status changes are also written to PlanEvent.
model IncomeOpportunity {
  id                   String                  @id @default(cuid())
  planId               String
  plan                 AssetPlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  category             String
  title                String
  currentCaptureCents  BigInt?
  fullRolloutCents     BigInt?
  setupCostCents       BigInt?
  ownerName            String?
  steps                String?
  legalNote            String?
  status               IncomeOpportunityStatus @default(IDEA)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([planId, createdAt])
}

enum PlanEventKind {
  PLAN_ANALYZED
  WEEKLY_UPDATE
  RECOMMENDATION_CREATED
  RECOMMENDATION_SUPERSEDED
  DECISION
  ACTION
  RESULT
}

/// Append-only tracking log. The app has no delete path for these rows.
model PlanEvent {
  id                   String        @id @default(cuid())
  planId               String
  plan                 AssetPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind                 PlanEventKind
  actor                String
  reason               String
  subjectType          String
  subjectId            String?
  beforeJson           String?
  afterJson            String?
  ownerName            String?
  dueDate              DateTime?
  status               String?
  completedAt          DateTime?
  note                 String?
  kpiBeforeJson        String?
  kpiAfterJson         String?
  expectedEffectCents  BigInt?
  sourceAsOf           DateTime?
  createdAt            DateTime      @default(now())

  @@index([planId, createdAt])
}

// --- Market Ranks (free public data v1). Additive. Not ledger, journal, close, or budget. ---

/// A data publisher or series. Paid rows may be registered later and stay inactive.
model MktSource {
  id                String   @id @default(cuid())
  name              String   @unique
  publisher         String
  url               String   @default("")
  termsUrl          String   @default("")
  /// public | manual_only | license_required | excluded
  licenseBasis      String
  automationAllowed Boolean  @default(false)
  costNotes         String   @default("")
  /// active | inactive | pending_license
  status            String
  paywalled         Boolean  @default(false)
  notes             String   @default("")
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  variables         MktVariableSource[]

  @@index([status, licenseBasis])
}

/// One model input. inScoreToday is true only when the approved source list says yes.
model MktVariable {
  id              String   @id
  name            String
  plainDefinition String
  pillar          String
  /// Short unit when the definition names one. Otherwise "data needed".
  unit            String
  /// higher_is_worse when the source list says so. Otherwise not_stated.
  expectedSign    String
  whyItMatters    String
  inScoreToday    Boolean
  /// The source-list cell, unchanged: yes, eligible but weight 0, or no.
  inScoreLabel    String
  /// Source cell from the approved list. An em dash means no source was named.
  sourceLabel     String
  weightNotes     String
  sortOrder       Int      @default(0)
  sources         MktVariableSource[]

  @@index([pillar, sortOrder])
}

model MktVariableSource {
  variableId String
  sourceId   String
  variable   MktVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  source     MktSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([variableId, sourceId])
}

/// One approved scoring method. Scores stay on the official version until a new one is approved.
model MktModelVersion {
  id                     String   @id
  code                   String   @unique
  name                   String
  derivationPlainEnglish String
  isOfficial             Boolean  @default(false)
  createdAt              DateTime @default(now())
  weightSets             MktWeightSet[]
  scoreRuns              MktScoreRun[]
}

/// Pillar weight or within-pillar weight. Fractions stay exact (numerator / denominator).
model MktWeightSet {
  id                String          @id
  modelVersionId    String
  modelVersion      MktModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  /// PILLAR or VARIABLE
  scope             String
  pillar            String
  variableId        String?
  weightNumerator   Int
  weightDenominator Int
  notes             String
  sortOrder         Int             @default(0)

  @@index([modelVersionId, sortOrder])
}

/// A point-in-time score run. Rows are kept. Nothing here is deleted because of age.
model MktScoreRun {
  id             String             @id
  modelVersionId String
  modelVersion   MktModelVersion    @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  asOf           DateTime
  isOfficial     Boolean            @default(false)
  label          String
  notes          String
  createdAt      DateTime           @default(now())
  scores         MktMetroScore[]
  backtest       MktBacktestResult?

  @@index([isOfficial])
}

model MktMetro {
  cbsaCode String          @id
  name     String
  scores   MktMetroScore[]
}

/// Official viability, rank, and pillar subscores for one metro on one run.
model MktMetroScore {
  id               String      @id
  runId            String
  run              MktScoreRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  metroId          String
  metro            MktMetro    @relation(fields: [metroId], references: [cbsaCode], onDelete: Cascade)
  rank             Int
  /// Viability Score × 10. 919 is 91.9. Never a guessed zero.
  viabilityTenths  Int
  band             String
  tiedWithinBand   String
  tiedCount        Int
  /// Rank interval × 1000. 1000 is 1.
  rankP5Milli      Int
  rankP95Milli     Int
  confidenceTenths Int
  momentum         String
  flags            String      @default("")
  /// JSON of pillar name to the Phase 5 subscore string. Missing pillars are omitted, not zero.
  pillarScoresJson String      @default("{}")
  createdAt        DateTime    @default(now())

  @@unique([runId, metroId])
  @@index([runId, rank])
}

/// The one honest backtest limitation stored with the official run.
model MktBacktestResult {
  id                     String      @id
  runId                  String      @unique
  run                    MktScoreRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  limitationPlainEnglish String
  createdAt              DateTime    @default(now())
}
