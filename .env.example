# --- Local SQLite demo (default — copy to .env and leave these as-is) ---
# Prisma resolves file: URLs relative to prisma/, so this is prisma/dev.db
DATABASE_URL="file:./dev.db"

# --- Vercel + Neon Postgres (production / preview) ---
# Prisma cannot use two providers in one schema. npm scripts pick automatically:
#   file:./dev.db          → prisma/schema.prisma (sqlite)
#   postgres://…           → prisma/schema.prod.prisma (postgresql)
#
# Preferred: Vercel Marketplace Neon (`vercel integration add neon`), which can
# inject POSTGRES_PRISMA_URL + POSTGRES_URL_NON_POOLING. This app also accepts
# those names if DATABASE_URL / DIRECT_URL are unset.
#
# DATABASE_URL = Neon *pooled* URL (hostname contains -pooler)
# DIRECT_URL   = Neon *unpooled* URL (same host without -pooler) for prisma db push
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional aliases used when the primary names are missing:
# POSTGRES_PRISMA_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# One-time / gated production seed (POST /api/admin/seed or /admin/seed).
# Must be at least 16 characters. If unset or shorter, the seed route returns 404.
# SEED_SECRET="replace-with-a-long-random-string"

TZ=America/New_York
NEXT_PUBLIC_RCP_CURRENCY=USD
NEXT_PUBLIC_RCP_LOCALE=en-US
NEXT_PUBLIC_RCP_TIMEZONE=America/New_York

# --- RCP Expert coach (optional) ---
# Live model replies. If unset, the Expert FAB still opens with a deterministic
# offline coach that reads completeness / anomaly tools from the database.
# Preferred: Vercel AI Gateway (OIDC on Vercel, or a gateway key locally).
# AI_GATEWAY_API_KEY=
# EXPERT_MODEL="openai/gpt-5.4"
# Also accepted: OPENAI_API_KEY or ANTHROPIC_API_KEY (server-only; never NEXT_PUBLIC_).
# VERCEL_OIDC_TOKEN is injected by `vercel env pull` / Vercel runtimes.

# --- Add Deal file sources (optional; upload works without these) ---
# Dropzone + API accept CSV, XLSX/XLS, PDF, images, and typical vault docs.
# Max 32 MB per file (same as /vault). Files upload one at a time — do not sum a
# four-file drop against the cap. Password-protected workbooks are rejected.
# Prefer BLOB_READ_WRITE_TOKEN for large OM PDFs.
# Server-only. Never prefix NEXT_PUBLIC_. Public Vercel demo has no partner auth yet —
# Add Deal still mutates the demo database (acceptable for the Principal demo).
# DROPBOX_ACCESS_TOKEN=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# GMAIL_ACCESS_TOKEN=
# MICROSOFT_ACCESS_TOKEN=
# RCP mailbox address is NOT decided yet. Do not hardcode one.
# RCP_INGEST_MAILBOX=
# RCP_DEFAULT_OPCO="RCP-OPCO"
# Durable file store for Add Deal + /vault. On Vercel, omit this to store
# bytes in Neon (StoredBlob). Set BLOB_READ_WRITE_TOKEN to prefer Vercel Blob.
# RCP_FILE_STORE=db
# BLOB_READ_WRITE_TOKEN=
