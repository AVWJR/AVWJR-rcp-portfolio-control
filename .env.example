# Phase A local demo uses SQLite. Prisma resolves this path relative to prisma/.
DATABASE_URL="file:./dev.db"

# Production / shared environments: switch prisma/schema.prisma provider to
# "postgresql" and set a Postgres URL, e.g.
# DATABASE_URL="postgresql://user:pass@localhost:5432/rcp_portfolio?schema=public"

TZ=America/New_York
NEXT_PUBLIC_RCP_CURRENCY=USD
NEXT_PUBLIC_RCP_LOCALE=en-US
NEXT_PUBLIC_RCP_TIMEZONE=America/New_York
