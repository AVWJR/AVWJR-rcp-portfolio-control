# --- Local SQLite demo (default — copy to .env and leave these as-is) ---
# Prisma resolves file: URLs relative to prisma/, so this is prisma/dev.db
DATABASE_URL="file:./dev.db"

# --- Vercel + Neon Postgres (production / preview) ---
# Prisma cannot use two providers in one schema. npm scripts pick automatically:
#   file:./dev.db          → prisma/schema.prisma (sqlite)
#   postgres://…           → prisma/schema.prod.prisma (postgresql)
#
# Preferred: Vercel Marketplace Neon (`vercel integration add neon`), which can
# inject POSTGRES_PRISMA_URL + POSTGRES_URL_NON_POOLING. This app also accepts
# those names if DATABASE_URL / DIRECT_URL are unset.
#
# DATABASE_URL = Neon *pooled* URL (hostname contains -pooler)
# DIRECT_URL   = Neon *unpooled* URL (same host without -pooler) for production prisma db push
# Preview deployments skip prisma db push so they cannot drop production columns.
# Set these only when the preview has its own database:
# PREVIEW_DATABASE_URL="postgresql://USER:PASSWORD@ep-preview-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# PREVIEW_DIRECT_URL="postgresql://USER:PASSWORD@ep-preview.REGION.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional aliases used when the primary names are missing:
# POSTGRES_PRISMA_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# One-time / gated production seed (POST /api/admin/seed or /admin/seed).
# Must be at least 16 characters. If unset or shorter, the seed route returns 404.
# SEED_SECRET="replace-with-a-long-random-string"

# Per-person logins (Auth.js credentials, users stored in this database).
# AUTH_SECRET must be at least 16 characters. Generate one and paste it in Vercel.
# openssl rand -base64 32
# AUTH_SECRET="replace-with-a-long-random-string"
# NEXTAUTH_SECRET is accepted as an alias for AUTH_SECRET.
# OWNER_EMAIL is the first owner's address. Open /login once, use that email, and
# choose a password of at least 10 characters. After that, invite everyone else
# from Admin → Users. The first account must match OWNER_EMAIL exactly.
# OWNER_EMAIL="vance@example.com"

# Shared partner link. Leave unset (auto): the old share link works only until
# the first user exists, then each person must sign in. Set to on to keep the
# shared link even after users exist. Set to off to turn the shared link off now.
# LEGACY_PARTNER_TOKEN="auto"

# Partner viewer gate (optional, legacy). When either value is set (8+ chars),
# anonymous visitors are read-only viewers until per-user accounts exist.
# Share: https://<app>/?share=PARTNER_VIEW_TOKEN
# Unlock writes: /unlock or https://<app>/?unlock=PRINCIPAL_PASSWORD
# PARTNER_VIEW_TOKEN="replace-with-a-long-share-token"
# VIEWER_PASSWORD="alias-for-PARTNER_VIEW_TOKEN"
# PRINCIPAL_PASSWORD="replace-with-principal-unlock"

# Nightly backup passphrase. Used by scripts/backup-postgres.sh and the GitHub
# Actions backup, not by the running website. Store the same value as a GitHub
# Actions secret named BACKUP_ENCRYPTION_KEY. At least 16 characters.
# Dumps are AES-256-GCM (file starts with RCPG). An older openssl CBC file will not restore.
# The backup job installs the pg_dump major version that matches Neon.
# Optional Vercel Blob copy: set repository variable BLOB_ACCESS to public or private.
# The job tries the preferred store, then the other one.
# BACKUP_ENCRYPTION_KEY="replace-with-a-long-passphrase"

TZ=America/New_York
NEXT_PUBLIC_RCP_CURRENCY=USD
NEXT_PUBLIC_RCP_LOCALE=en-US
NEXT_PUBLIC_RCP_TIMEZONE=America/New_York

# --- RCP Expert coach (optional) ---
# Primary go-live: Vercel AI Gateway (they added a Gateway card).
# Working Gateway text id (public catalog): spacexai/grok-4.6
# Docs-era alias xai/grok-4.6 is rewritten to spacexai/ on the Gateway path.
# AI_GATEWAY_API_KEY=
# EXPERT_MODEL="spacexai/grok-4.6"
# Optional fallback: direct xAI (https://api.x.ai/v1)
# XAI_API_KEY=
# GROK_API_KEY=
# EXPERT_MODEL="grok-4.6"
# If no key is set, the Expert FAB still opens with the offline coach.
# Also accepted: OPENAI_API_KEY or ANTHROPIC_API_KEY (server-only; never NEXT_PUBLIC_).

# --- Add Deal file sources (optional; upload works without these) ---
# Dropzone + API accept CSV, XLSX/XLS, PDF, images, and typical vault docs.
# Max 32 MB per file (same as /vault). Files upload one at a time — do not sum a
# four-file drop against the cap. Password-protected workbooks are rejected.
# On Vercel, files over ~3.5 MB (a 5.5 MB OM) require BLOB_READ_WRITE_TOKEN so
# bytes go through @vercel/blob client upload, not the ~4.5 MB function body.
# Server-only. Never prefix NEXT_PUBLIC_. With PARTNER_VIEW_TOKEN set, public
# visitors cannot mutate Add Deal or vault uploads; Principal unlocks with PRINCIPAL_PASSWORD.
# DROPBOX_ACCESS_TOKEN=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# GMAIL_ACCESS_TOKEN=
# MICROSOFT_ACCESS_TOKEN=
# RCP mailbox address is NOT decided yet. Do not hardcode one.
# RCP_INGEST_MAILBOX=
# RCP_DEFAULT_OPCO="RCP-OPCO"
# Durable file store for Add Deal + /vault. On Vercel, omit this to store
# small files in Neon (StoredBlob). BLOB_READ_WRITE_TOKEN is required for
# OM PDFs / any file over ~3.5 MB (Vercel → Storage → Blob → token → redeploy).
# RCP_FILE_STORE=db
# BLOB_READ_WRITE_TOKEN=
