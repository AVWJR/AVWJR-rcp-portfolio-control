{
  "name": "rcp-portfolio-control",
  "version": "0.1.0",
  "private": true,
  "description": "Roche Capital Partners — Portfolio Control / OpCo Accounting System (Phase F tax, vault, scheduler)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-prepare.mjs -- generate && next build",
    "vercel-build": "node scripts/prisma-prepare.mjs -- generate && PRISMA_PUSH_TOLERATE_DRIFT=1 node scripts/prisma-prepare.mjs -- db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/prisma-prepare.mjs -- generate",
    "db:generate": "node scripts/prisma-prepare.mjs -- generate",
    "db:push": "node scripts/prisma-prepare.mjs -- db push",
    "db:prepare": "node scripts/prisma-prepare.mjs",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "node scripts/prisma-prepare.mjs -- db push && tsx --env-file=.env prisma/seed.ts",
    "verify": "tsx --env-file=.env scripts/verify-phase-a.ts && tsx --env-file=.env scripts/verify-phase-b.ts && tsx --env-file=.env scripts/verify-phase-c.ts && tsx --env-file=.env scripts/verify-phase-d.ts && tsx --env-file=.env scripts/verify-phase-e.ts && tsx --env-file=.env scripts/verify-phase-f.ts",
    "verify:a": "tsx --env-file=.env scripts/verify-phase-a.ts",
    "verify:b": "tsx --env-file=.env scripts/verify-phase-b.ts",
    "verify:c": "tsx --env-file=.env scripts/verify-phase-c.ts",
    "verify:d": "tsx --env-file=.env scripts/verify-phase-d.ts",
    "verify:e": "tsx --env-file=.env scripts/verify-phase-e.ts",
    "verify:f": "tsx --env-file=.env scripts/verify-phase-f.ts",
    "reports:run": "tsx --env-file=.env scripts/run-reports.ts",
    "import:rent-roll": "tsx --env-file=.env scripts/import-rent-roll.ts",
    "import:budget": "tsx --env-file=.env scripts/import-budget.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^6.16.1",
    "@prisma/client": "^6.16.1",
    "@rcp/analytics": "file:packages/analytics",
    "@rcp/debt": "file:packages/debt",
    "@rcp/documents": "file:packages/documents",
    "@rcp/entities": "file:packages/entities",
    "@rcp/ledger": "file:packages/ledger",
    "@rcp/properties": "file:packages/properties",
    "@rcp/rcp-brand": "file:packages/rcp-brand",
    "@rcp/reporting": "file:packages/reporting",
    "@rcp/tax-bridge": "file:packages/tax-bridge",
    "@vercel/blob": "^2.8.0",
    "ai": "^6.0.34",
    "next": "^15.5.3",
    "pdfkit": "^0.17.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "postcss": "^8.5.6",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
